  "drive": "ai-memory-backup", "guarda": "14 no servidor · 90 dias no Drive",
  "recuperar": "memoria-reserva ligar"
 },
 {
  "id": "banco", "nome": "Banco da loja", "origem": "produção (VPS da loja)",
  "log": "/var/log/backup-banco.log", "script": "backup-banco.sh",
  "ok": "^== (\\S+ \\S+) ok: (\\S+) \\(([^)]+)\\)", "falha": "^!! (\\S+ \\S+) (.+)",
  "drive": "banco-backup", "guarda": "14 no servidor · 90 dias no Drive",
  "recuperar": "pg_restore -d loja banco-AAAAMMDD-HHMM.dump"
 }

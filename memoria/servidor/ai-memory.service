[Unit]
Description=ai-memory (memoria compartilhada dos agentes) - servidor central no Saturno
Documentation=https://github.com/akitaonrails/ai-memory
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ai-memory
Group=ai-memory
EnvironmentFile=/etc/ai-memory/env
Environment=HOME=/var/lib/ai-memory-backups
ExecStart=/usr/local/bin/ai-memory --data-dir /var/lib/ai-memory serve --transport http --bind 127.0.0.1:49374 --enable-web
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ai-memory /var/lib/ai-memory-backups

[Install]
WantedBy=multi-user.target

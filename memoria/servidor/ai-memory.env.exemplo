# /etc/ai-memory/env — NO SERVIDOR, root:ai-memory, chmod 640. Lido pelo systemd (ai-memory.service).
AI_MEMORY_AUTH_TOKEN=o-mesmo-token-do-mac
# Nomes pelos quais o servidor aceita ser chamado (o endereço do Tailscale, com e sem a porta):
AI_MEMORY_ALLOWED_HOSTS=SEU-SERVIDOR.tailnet.ts.net,SEU-SERVIDOR.tailnet.ts.net:8443,localhost,127.0.0.1

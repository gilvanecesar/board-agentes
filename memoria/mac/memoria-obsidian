#!/bin/bash
# Monta/atualiza o cofre do Obsidian "Memória" (~/Documents/Memoria) — SÓ PARA VER, não para editar.
#   ai-memory/<projeto>/  espelho do wiki do ai-memory no Saturno (nomes legíveis, sem _lint/_meta)
#   portatil/             link para MEMORIA_PORTATIL, se definido (uma memória extra, versionada)
#   projetos/<projeto>/   link para a memória de cada projeto do Claude Code no Mac
# Quem roda a cada 10 min é o board (ele tem acesso à ~/Documents; o cron do macOS não tem).
set -uo pipefail
export PATH="/opt/homebrew/bin:$HOME/.local/bin:/usr/bin:/bin"
COFRE="$HOME/Documents/Memoria"; CACHE="$HOME/.local/share/memoria-obsidian/wiki"
FORA="${MEMORIA_FORA:-}"                                      # projetos a deixar de fora do cofre
mkdir -p "$COFRE/ai-memory" "$COFRE/projetos" "$CACHE"
rsync -a --delete --exclude .git -e "ssh -o BatchMode=yes -o ConnectTimeout=8" --rsync-path="sudo rsync" \
  saturno:/var/lib/ai-memory/wiki/ "$CACHE/" || { echo "$(date '+%F %T') não consegui ler o Saturno" >&2; exit 1; }
usados=" "
for ws in "$CACHE"/*/; do
  for p in "$ws"*/; do
    [ -f "$p/_meta.md" ] || continue
    nome=$(grep -m1 -E "^project:" "$p/_meta.md" | cut -d: -f2- | tr -d ' ')
    [ -n "$nome" ] || continue; case " $FORA " in *" $nome "*) continue;; esac
    alvo="$nome"; n=2; while [[ "$usados" == *" $alvo "* ]]; do alvo="$nome-$n"; n=$((n+1)); done; usados="$usados$alvo "
    rsync -a --delete --exclude "_lint/" --exclude "_meta.md" "$p" "$COFRE/ai-memory/$alvo/"
  done
done
for d in "$COFRE"/ai-memory/*/; do b=$(basename "$d"); [[ "$usados" == *" $b "* ]] || rm -rf "$d"; done
[ -n "${MEMORIA_PORTATIL:-}" ] && ln -sfn "$MEMORIA_PORTATIL" "$COFRE/portatil"
for m in "$HOME"/.claude/projects/*/memory; do
  ls "$m"/*.md >/dev/null 2>&1 || continue
  slug=$(basename "$(dirname "$m")" | sed -E 's/^-Users-[^-]+-Documents-DEV-?//; s/^-Users-[^-]+$/home/; s/^$/DEV/'); ln -sfn "$m" "$COFRE/projetos/${slug:-DEV}"
done
[ -f "$COFRE/Comece aqui.md" ] || cat > "$COFRE/Comece aqui.md" <<'MD'
# Memória — só para ver

Este cofre junta, num lugar só, tudo o que os agentes lembram:

- **ai-memory/** — a memória compartilhada entre os modelos (Claude, Codex, Gemini, opencode), espelhada do
  Saturno a cada 10 minutos. `_global` vale para todos os projetos.
- **portatil/** — uma memória extra, se `MEMORIA_PORTATIL` estiver definida.
- **projetos/** — a memória de cada projeto no Mac.

Abra o **Grafo** (Cmd+G) para ver as ligações entre decisões, regras e projetos.

⚠️ **Não edite aqui.** A pasta `ai-memory/` é sobrescrita a cada atualização; para mudar a memória, peça a um agente.
MD
echo "$(date '+%F %T') cofre atualizado: $(find -L "$COFRE" -name '*.md' | wc -l | tr -d ' ') notas"
